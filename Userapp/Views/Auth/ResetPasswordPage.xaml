<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CGM.PatientApp.ViewModels.Auth"
             x:Class="CGM.PatientApp.Views.Auth.ResetPasswordPage"
             x:DataType="vm:ResetPasswordViewModel"
             BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#0F172A}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24,24,24,24" RowDefinitions="Auto,*,Auto">

            <!-- Top Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalOptions="Center" Margin="0,0,0,20">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="38"
                        HeightRequest="38"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource BorderLightColor}">
                        <Label Text="&#xF060;" FontFamily="FontAwesomeSolid" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1"
                       Text="Set New Password"
                       FontAttributes="Bold"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       Margin="-38,0,0,0" />
            </Grid>

            <!-- Main Content -->
            <VerticalStackLayout Grid.Row="1" Spacing="16">
                <!-- Shield Graphic -->
                <Border StrokeShape="RoundRectangle 45"
                        WidthRequest="80"
                        HeightRequest="80"
                        BackgroundColor="{StaticResource PrimaryContainerLight}"
                        Stroke="{StaticResource PrimaryLight}"
                        StrokeThickness="2"
                        HorizontalOptions="Center">
                    <Label Text="&#xF084;" FontFamily="FontAwesomeSolid" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Titles -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Create New Password"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Enter the 6-digit code sent to your email and choose a new secure password."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondaryLight}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- 15-Minute Expiration Notice Banner -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FEF3C7"
                        Stroke="#FDE68A"
                        StrokeThickness="1"
                        Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="&#xF017;" FontFamily="FontAwesomeRegular" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="For security, your reset code is valid for 15 minutes."
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#92400E"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Error Message Banner -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FEE2E2"
                        Stroke="#FCA5A5"
                        StrokeThickness="1"
                        Padding="14,10"
                        IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="&#xF071;" FontFamily="FontAwesomeSolid" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#DC2626"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- 1. Reset Code Input -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="6-Digit Reset Code" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputContainerBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#x23;" FontFamily="FontAwesomeSolid" FontSize="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Placeholder="e.g. 123456"
                                   Text="{Binding OtpCode}"
                                   Keyboard="Numeric"
                                   MaxLength="10"
                                   ReturnType="Next" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. New Password -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="New Password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputContainerBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#xF023;" FontFamily="FontAwesomeSolid" FontSize="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Placeholder="••••••••"
                                   Text="{Binding NewPassword}"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   ReturnType="Next" />
                            <Border Grid.Column="2" BackgroundColor="Transparent" Stroke="Transparent" Padding="4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding PasswordIcon}" FontFamily="FontAwesomeRegular" FontSize="15" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. Confirm Password -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Confirm New Password" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputContainerBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#xF023;" FontFamily="FontAwesomeSolid" FontSize="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Placeholder="••••••••"
                                   Text="{Binding ConfirmPassword}"
                                   IsPassword="{Binding IsConfirmPasswordHidden}"
                                   ReturnType="Done" />
                            <Border Grid.Column="2" BackgroundColor="Transparent" Stroke="Transparent" Padding="4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleConfirmPasswordVisibilityCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding ConfirmPasswordIcon}" FontFamily="FontAwesomeRegular" FontSize="15" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Submit Button -->
                <Button Text="Update Password"
                        Command="{Binding ResetPasswordCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="14"
                        Margin="0,8,0,0" />

                <!-- Loading Spinner -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryLight}"
                                   HorizontalOptions="Center" />

                <!-- Resend / Back Links -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                    <Button Text="Resend Code"
                            Command="{Binding ResendCodeCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextSecondaryLight}"
                            FontSize="12"
                            HeightRequest="36" />
                    <Label Text="•" TextColor="{StaticResource TextMutedLight}" VerticalOptions="Center" />
                    <Button Text="Back to Sign In"
                            Command="{Binding BackToLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryLight}"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="36" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Bottom Security Footer -->
            <Border Grid.Row="2"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource PrimaryContainerLight}"
                    Stroke="Transparent"
                    Padding="16,12"
                    Margin="0,20,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource White}" Stroke="Transparent" VerticalOptions="Center">
                    <Label Text="&#xF3ED;" FontFamily="FontAwesomeSolid" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Encrypted &amp; Secure" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource BadgeGreenText}" />
                        <Label Text="Your new password is encrypted with medical-grade hashing." FontSize="11" TextColor="{StaticResource TextSecondaryLight}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
