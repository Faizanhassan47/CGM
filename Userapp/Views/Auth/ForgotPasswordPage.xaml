<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CGM.PatientApp.ViewModels.Auth"
             x:Class="CGM.PatientApp.Views.Auth.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#0F172A}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="24,24,24,24" RowDefinitions="Auto,*,Auto">

            <!-- Top Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalOptions="Center" Margin="0,0,0,24">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20"
                        WidthRequest="38"
                        HeightRequest="38"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource BorderLightColor}">
                        <Label Text="&#xF060;" FontFamily="FontAwesomeSolid" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Label Grid.Column="1"
                       Text="Forgot Password"
                       FontAttributes="Bold"
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       Margin="-38,0,0,0" />
            </Grid>

            <!-- Main Content -->
            <VerticalStackLayout Grid.Row="1" Spacing="20">
                <!-- Shield Graphic -->
                <Border StrokeShape="RoundRectangle 45"
                        WidthRequest="90"
                        HeightRequest="90"
                        BackgroundColor="{StaticResource PrimaryContainerLight}"
                        Stroke="{StaticResource PrimaryLight}"
                        StrokeThickness="2"
                        HorizontalOptions="Center">
                    <Label Text="&#xF023;" FontFamily="FontAwesomeSolid" FontSize="42" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Titles -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Reset your password"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="No worries! Enter your email or phone number and we'll send you a reset code to get back into your account."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondaryLight}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Error Message Banner -->
                <Border StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FEE2E2"
                        Stroke="#FCA5A5"
                        StrokeThickness="1"
                        Padding="14,10"
                        IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="&#xF071;" FontFamily="FontAwesomeSolid" FontSize="16" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#DC2626"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Input -->
                <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                    <Label Text="Email Address" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputContainerBorder}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="&#xF0E0;" FontFamily="FontAwesomeRegular" FontSize="15" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Placeholder="you@example.com"
                                   Text="{Binding Identifier}"
                                   Keyboard="Email"
                                   ReturnType="Done" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Send Reset Code Button -->
                <Button Text="Send Reset Code"
                        Command="{Binding SendResetCodeCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource PrimaryLight}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="14" />

                <!-- Loading Spinner -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryLight}"
                                   HorizontalOptions="Center" />

                <!-- Back to Sign In -->
                <Button Text="Back to Sign In"
                        Command="{Binding BackToLoginCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryLight}"
                        FontAttributes="Bold"
                        FontSize="13"
                        HeightRequest="36" />
            </VerticalStackLayout>

            <!-- Bottom Security Reassurance Card -->
            <Border Grid.Row="2"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{StaticResource PrimaryContainerLight}"
                    Stroke="Transparent"
                    Padding="16,12"
                    Margin="0,20,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" WidthRequest="38" HeightRequest="38" BackgroundColor="{StaticResource White}" Stroke="Transparent" VerticalOptions="Center">
                        <Label Text="&#xF3ED;" FontFamily="FontAwesomeSolid" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Your account is safe with us" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource BadgeGreenText}" />
                        <Label Text="We use industry-standard encryption to protect your data and keep your information secure." FontSize="11" TextColor="{StaticResource TextSecondaryLight}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
