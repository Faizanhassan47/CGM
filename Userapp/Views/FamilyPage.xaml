<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CGM.PatientApp.ViewModels"
             x:Class="CGM.PatientApp.Views.FamilyPage"
             x:DataType="vm:FamilyViewModel"
             Title="Family"
             BackgroundColor="{AppThemeBinding Light=#F7F5FA, Dark=#120C1B}">

    <Grid RowDefinitions="Auto,*">
        <!-- App bar -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1329}"
                StrokeThickness="0"
                Padding="16,12">
            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="12">
                <Border WidthRequest="42" HeightRequest="42"
                        BackgroundColor="{AppThemeBinding Light=#F5F0FA, Dark=#302040}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="BackClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xF060;" FontFamily="FontAwesomeSolid" FontSize="15"
                           TextColor="{AppThemeBinding Light=#583295, Dark=#D9C2F3}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="Family circle" FontFamily="ManropeBold" FontSize="19"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" />
                    <Label Text="People you trust" FontSize="11"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" />
                </VerticalStackLayout>

                <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}" Color="#01B4F1"
                                   WidthRequest="24" HeightRequest="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,20,18,44" Spacing="16">

                <!-- Error -->
                <Border IsVisible="{Binding HasError}" BackgroundColor="#FFF1F2"
                        Stroke="#FECDD3" StrokeThickness="1" Padding="14,12"
                        StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="&#xF071;" FontFamily="FontAwesomeSolid" FontSize="14"
                               TextColor="#E11D48" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12"
                               TextColor="#9F1239" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <!-- Existing family -->
                <VerticalStackLayout IsVisible="{Binding HasFamily}" Spacing="18">
                    <Border StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 24"
                            BackgroundColor="#583295">
                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="YOUR CIRCLE" FontFamily="ManropeBold" FontSize="10"
                                           CharacterSpacing="1.8" TextColor="#DCCCEE" />
                                    <Label Text="{Binding FamilyName}" FontFamily="ManropeBold" FontSize="24"
                                           TextColor="#FFFFFF" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Padding="10,6" BackgroundColor="#24FFFFFF"
                                        Stroke="#44FFFFFF" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Start">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#xF3ED;" FontFamily="FontAwesomeSolid" FontSize="10"
                                               TextColor="#FFFFFF" VerticalOptions="Center" />
                                        <Label Text="Private" FontFamily="ManropeSemiBold" FontSize="11"
                                               TextColor="#FFFFFF" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Border BackgroundColor="#18FFFFFF" Stroke="#2EFFFFFF" StrokeThickness="1"
                                    Padding="14" StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="INVITE CODE" FontFamily="ManropeBold" FontSize="9"
                                               CharacterSpacing="1.5" TextColor="#CFC0DE" />
                                        <Label Text="{Binding ReferralCode}" FontFamily="ManropeBold" FontSize="25"
                                               CharacterSpacing="3" TextColor="#FFFFFF" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Button Text="&#xF0C5;" FontFamily="FontAwesomeSolid" FontSize="14"
                                                Command="{Binding CopyCommand}" WidthRequest="42" HeightRequest="42"
                                                Padding="0" CornerRadius="13" BackgroundColor="#FFFFFF" TextColor="#583295" />
                                        <Button Text="&#xF1E0;" FontFamily="FontAwesomeSolid" FontSize="14"
                                                Command="{Binding ShareCommand}" WidthRequest="42" HeightRequest="42"
                                                Padding="0" CornerRadius="13" BackgroundColor="#2CFFFFFF"
                                                BorderColor="#55FFFFFF" BorderWidth="1" TextColor="#FFFFFF" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Follower Mini-Dashboard -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Live Follower Dashboard" FontFamily="ManropeBold" FontSize="18"
                               TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" Margin="2,0,0,0"/>
                        
                        <CollectionView ItemsSource="{Binding Members}" VerticalOptions="Start">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FamilyMemberItem">
                                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1329}"
                                            Stroke="{AppThemeBinding Light=#EAE4EF, Dark=#382848}"
                                            StrokeThickness="1" Padding="14,16" StrokeShape="RoundRectangle 16">
                                        <VerticalStackLayout Spacing="10">
                                            <!-- Avatar & Name -->
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <Border WidthRequest="32" HeightRequest="32"
                                                        BackgroundColor="{Binding AvatarColor}" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                                    <Label Text="{Binding Initials}" FontFamily="ManropeBold" FontSize="12"
                                                           TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding FullName}" FontFamily="ManropeBold" FontSize="13"
                                                       TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}"
                                                       LineBreakMode="TailTruncation" VerticalOptions="Center" MaxLines="1" />
                                            </HorizontalStackLayout>
                                            
                                            <!-- Glucose & Trend -->
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding CurrentGlucose}" FontFamily="ManropeBold" FontSize="26"
                                                       TextColor="{Binding GlucoseColor}" VerticalOptions="Center" />
                                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                    <Label Text="{Binding TrendArrow}" FontFamily="ManropeBold" FontSize="16"
                                                           TextColor="{Binding GlucoseColor}" Margin="0,2,0,0" />
                                                    <Label Text="mg/dL" FontSize="10" TextColor="{AppThemeBinding Light=#918699, Dark=#AFA0BD}" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Alert range -->
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1329}"
                            Stroke="{AppThemeBinding Light=#EAE4EF, Dark=#382848}"
                            StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="11">
                                <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=#E9F8FD, Dark=#173544}"
                                        StrokeShape="RoundRectangle 13">
                                    <Label Text="&#xF0F3;" FontFamily="FontAwesomeSolid" FontSize="16"
                                           TextColor="#01A4DC" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Shared alert range" FontFamily="ManropeBold" FontSize="16"
                                           TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" />
                                    <Label Text="Members are notified outside this range" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Padding="8,4" BackgroundColor="#F0EAF7"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                                    <Label Text="mg/dL" FontFamily="ManropeSemiBold" FontSize="10" TextColor="#583295" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F6FA, Dark=#261A34}"
                                        Stroke="{AppThemeBinding Light=#E8E1ED, Dark=#3C2B4D}"
                                        StrokeThickness="1" Padding="13,10" StrokeShape="RoundRectangle 14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="LOW" FontFamily="ManropeBold" FontSize="9"
                                               CharacterSpacing="1.2" TextColor="#01A4DC" />
                                        <Entry Text="{Binding LowThreshold}" Keyboard="Numeric" FontFamily="ManropeBold"
                                               FontSize="18" TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}"
                                               BackgroundColor="Transparent" Margin="0" HeightRequest="36"
                                               VerticalOptions="Center" VerticalTextAlignment="Center"
                                               IsReadOnly="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label Grid.Column="1" Text="—" FontSize="18" TextColor="#A79CAD"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F8F6FA, Dark=#261A34}"
                                        Stroke="{AppThemeBinding Light=#E8E1ED, Dark=#3C2B4D}"
                                        StrokeThickness="1" Padding="13,10" StrokeShape="RoundRectangle 14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="HIGH" FontFamily="ManropeBold" FontSize="9"
                                               CharacterSpacing="1.2" TextColor="#E06A78" />
                                        <Entry Text="{Binding HighThreshold}" Keyboard="Numeric" FontFamily="ManropeBold"
                                               FontSize="18" TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}"
                                               BackgroundColor="Transparent" Margin="0" HeightRequest="36"
                                               VerticalOptions="Center" VerticalTextAlignment="Center"
                                               IsReadOnly="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Button Text="Save alert range" IsVisible="{Binding IsOwner}"
                                    Command="{Binding SaveThresholdsCommand}" HeightRequest="48" CornerRadius="14"
                                    BackgroundColor="#583295" TextColor="#FFFFFF" FontFamily="ManropeBold" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Members -->
                    <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,0">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Circle members" FontFamily="ManropeBold" FontSize="18"
                                   TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" />
                            <Label Text="Choose who receives glucose alerts" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#EEE8F4, Dark=#302040}"
                                StrokeThickness="0" Padding="10,5" StrokeShape="RoundRectangle 11"
                                VerticalOptions="Center">
                            <Label Text="{Binding Members.Count}" FontFamily="ManropeBold" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#583295, Dark=#D9C2F3}" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:FamilyMemberItem">
                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1329}"
                                        Stroke="{AppThemeBinding Light=#EAE4EF, Dark=#382848}"
                                        StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 18">
                                    <Grid ColumnDefinitions="46,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                        <Border Grid.RowSpan="2" WidthRequest="44" HeightRequest="44"
                                                BackgroundColor="{Binding AvatarColor}" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                                            <Label Text="{Binding Initials}" FontFamily="ManropeBold" FontSize="14"
                                                   TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="7">
                                            <Label Text="{Binding FullName}" FontFamily="ManropeBold" FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}"
                                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                            <Border BackgroundColor="{Binding RoleBadgeColor}" StrokeThickness="0"
                                                    Padding="7,2" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                                                <Label Text="{Binding Role}" FontFamily="ManropeSemiBold" FontSize="9"
                                                       TextColor="{Binding RoleTextColor}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Email}" FontSize="11"
                                               TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}"
                                               LineBreakMode="TailTruncation" />

                                        <VerticalStackLayout Grid.Column="2" Grid.RowSpan="2" Spacing="5" VerticalOptions="Center">
                                            <Button Text="{Binding AlertsText}" FontFamily="ManropeSemiBold" FontSize="10"
                                                    HeightRequest="30" MinimumHeightRequest="30" Padding="10,0" CornerRadius="10"
                                                    BackgroundColor="{Binding AlertsBackgroundColor}" TextColor="{Binding AlertsTextColor}"
                                                    IsEnabled="{Binding CanToggleAlerts}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleAlertsCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="View Report" IsVisible="{Binding CanViewReport}" FontFamily="ManropeSemiBold"
                                                    FontSize="10" HeightRequest="28" MinimumHeightRequest="28" Padding="10,0"
                                                    CornerRadius="10" BackgroundColor="#E9F8FD" TextColor="#01A4DC"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewReportCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Alert Owner" IsVisible="{Binding IsOwnerProfile}" FontFamily="ManropeSemiBold"
                                                    FontSize="10" HeightRequest="28" MinimumHeightRequest="28" Padding="10,0"
                                                    CornerRadius="10" BackgroundColor="#F1EAF8" TextColor="#583295"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AlertOwnerCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Remove" IsVisible="{Binding CanRemove}" FontFamily="ManropeSemiBold"
                                                    FontSize="10" HeightRequest="28" MinimumHeightRequest="28" Padding="10,0"
                                                    CornerRadius="10" BackgroundColor="#FFF1F2" TextColor="#E11D48"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Leave this family" Command="{Binding LeaveCommand}"
                            HeightRequest="48" CornerRadius="14" BackgroundColor="Transparent"
                            BorderColor="#F3B9C1" BorderWidth="1" TextColor="#D63850"
                            FontFamily="ManropeBold" FontSize="13" Margin="0,4,0,0" />
                </VerticalStackLayout>

                <!-- No-family state -->
                <VerticalStackLayout IsVisible="{Binding HasNoFamily}" Spacing="18">
                    <VerticalStackLayout Spacing="8" Margin="16,12,16,8">
                        <Border WidthRequest="76" HeightRequest="76" HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light=#EEE8F7, Dark=#302040}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 25">
                            <Label Text="&#xF0C0;" FontFamily="FontAwesomeSolid" FontSize="29"
                                   TextColor="{AppThemeBinding Light=#583295, Dark=#D9C2F3}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Stay connected" FontFamily="ManropeBold" FontSize="25"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" />
                        <Label Text="Create a private circle for your family, or use an invite code to join one."
                               FontSize="13" LineHeight="1.35" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1329}"
                            Stroke="{AppThemeBinding Light=#EAE4EF, Dark=#382848}"
                            StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#E9F8FD"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                    <Label Text="&#xF2B5;" FontFamily="FontAwesomeSolid" FontSize="17" TextColor="#019BCC"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Join a circle" FontFamily="ManropeBold" FontSize="16"
                                           TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" />
                                    <Label Text="Ask the owner for their invite code" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F6FA, Dark=#261A34}"
                                    Stroke="{AppThemeBinding Light=#E8E1ED, Dark=#3C2B4D}"
                                    StrokeThickness="1" Padding="14,2" StrokeShape="RoundRectangle 14">
                                <Entry Placeholder="Enter invite code" Text="{Binding JoinCode}" MaxLength="12"
                                       CharacterSpacing="2" FontFamily="ManropeSemiBold" FontSize="15"
                                       TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}"
                                       PlaceholderColor="{AppThemeBinding Light=#A79CAD, Dark=#887996}" />
                            </Border>
                            <Button Text="Join family" Command="{Binding JoinCommand}" HeightRequest="48"
                                    CornerRadius="14" BackgroundColor="#01A4DC" TextColor="#FFFFFF"
                                    FontFamily="ManropeBold" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="14,0">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E3DDE8, Dark=#382848}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="or start your own" FontSize="10"
                               TextColor="{AppThemeBinding Light=#9A8FA3, Dark=#A899B5}" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{AppThemeBinding Light=#E3DDE8, Dark=#382848}" VerticalOptions="Center" />
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1329}"
                            Stroke="{AppThemeBinding Light=#EAE4EF, Dark=#382848}"
                            StrokeThickness="1" Padding="18" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
                                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#F1EAF8"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 13">
                                    <Label Text="&#xF067;" FontFamily="FontAwesomeSolid" FontSize="15" TextColor="#583295"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Create a circle" FontFamily="ManropeBold" FontSize="16"
                                           TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" />
                                    <Label Text="You’ll manage members and alert settings" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F6FA, Dark=#261A34}"
                                    Stroke="{AppThemeBinding Light=#E8E1ED, Dark=#3C2B4D}"
                                    StrokeThickness="1" Padding="14,2" StrokeShape="RoundRectangle 14">
                                <Entry Placeholder="Family name" Text="{Binding NewFamilyName}" MaxLength="150"
                                       FontFamily="ManropeSemiBold" FontSize="15"
                                       TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}"
                                       PlaceholderColor="{AppThemeBinding Light=#A79CAD, Dark=#887996}" />
                            </Border>
                            <Button Text="Create family" Command="{Binding CreateCommand}" HeightRequest="48"
                                    CornerRadius="14" BackgroundColor="#583295" TextColor="#FFFFFF"
                                    FontFamily="ManropeBold" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Report Overlay -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsReportOverlayVisible}" BackgroundColor="#80000000">
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1D1329}"
                    Stroke="{AppThemeBinding Light=#EAE4EF, Dark=#382848}"
                    StrokeThickness="1" Padding="24" StrokeShape="RoundRectangle 24"
                    HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="320">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Select Date Range" FontFamily="ManropeBold" FontSize="18" TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" />
                    
                    <Label Text="From" FontFamily="ManropeSemiBold" FontSize="12" TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" Margin="0,0,0,-10" />
                    <DatePicker Date="{Binding ReportStartDate}" TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" BackgroundColor="{AppThemeBinding Light=#F8F6FA, Dark=#261A34}" />
                    
                    <Label Text="To" FontFamily="ManropeSemiBold" FontSize="12" TextColor="{AppThemeBinding Light=#81758C, Dark=#B8A9C5}" Margin="0,0,0,-10" />
                    <DatePicker Date="{Binding ReportEndDate}" TextColor="{AppThemeBinding Light=#241632, Dark=#FFFFFF}" BackgroundColor="{AppThemeBinding Light=#F8F6FA, Dark=#261A34}" />
                    
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="End" Margin="0,10,0,0">
                        <Button Text="Cancel" Command="{Binding CancelReportCommand}" HeightRequest="40" CornerRadius="10" BackgroundColor="Transparent" TextColor="#81758C" FontFamily="ManropeSemiBold" FontSize="13" />
                        <Button Text="Generate" Command="{Binding GenerateReportCommand}" HeightRequest="40" CornerRadius="10" BackgroundColor="#583295" TextColor="#FFFFFF" FontFamily="ManropeBold" FontSize="13" Padding="16,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
