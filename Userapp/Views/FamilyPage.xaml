<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CGM.PatientApp.Views.FamilyPage"
             Title="Family" BackgroundColor="#F6F8F8">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="18,14,18,12" ColumnDefinitions="44,*,44" BackgroundColor="White">
            <Border WidthRequest="40" HeightRequest="40" Stroke="#E5EDEC" StrokeShape="RoundRectangle 20" BackgroundColor="#F8FAFA">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="BackClicked" /></Border.GestureRecognizers>
                <Label Text="&#xF060;" FontFamily="FontAwesomeSolid" FontSize="15" TextColor="#163B38" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="Center">
                <Label Text="Family monitoring" FontFamily="ManropeBold" FontSize="19" HorizontalTextAlignment="Center" />
                <Label Text="Keep your circle informed" FontSize="11" TextColor="#71817F" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0D9488" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,18,18,34" Spacing="16">
                <Border IsVisible="{Binding HasError}"
                        Stroke="#FECACA" BackgroundColor="#FEF2F2" Padding="13" StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
                        <Label Text="&#xF071;" FontFamily="FontAwesomeSolid" TextColor="#DC2626" />
                        <Label Grid.Column="1" Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="12" />
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasFamily}" Spacing="16">
                    <Border StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 22">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0F9D8F" Offset="0"/><GradientStop Color="#087268" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="YOUR FAMILY" TextColor="#C9FFF8" FontSize="10" CharacterSpacing="1.5" FontFamily="ManropeBold" />
                                <Label Text="{Binding FamilyName}" TextColor="White" FontSize="23" FontFamily="ManropeBold" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#28FFFFFF" StrokeThickness="0" Padding="10,6" StrokeShape="RoundRectangle 14">
                                <Label Text="Protected" TextColor="White" FontSize="11" />
                            </Border>
                            <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#38FFFFFF" />
                            <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="3">
                                <Label Text="INVITE CODE" TextColor="#C9FFF8" FontSize="10" CharacterSpacing="1.3" />
                                <Label Text="{Binding ReferralCode}" TextColor="White" FontSize="29" CharacterSpacing="4" FontFamily="ManropeBold" />
                                <Label Text="Share this code only with people you trust." TextColor="#DDFBF7" FontSize="11" />
                            </VerticalStackLayout>
                            <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="&#xF0C5;  Copy code" FontFamily="ManropeSemiBold" Command="{Binding CopyCommand}" BackgroundColor="White" TextColor="#087268" CornerRadius="12" HeightRequest="44" Padding="8" />
                                <Button Grid.Column="1" Text="&#xF1E0;  Share invite" FontFamily="ManropeSemiBold" Command="{Binding ShareCommand}" BackgroundColor="#28FFFFFF" TextColor="White" BorderColor="#66FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="44" Padding="8" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MedicalCard}" StrokeShape="RoundRectangle 18" Padding="18">
                        <VerticalStackLayout Spacing="15">
                            <Grid ColumnDefinitions="42,*">
                                <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" BackgroundColor="#E8F7F5" StrokeShape="RoundRectangle 12">
                                    <Label Text="&#xF0F3;" FontFamily="FontAwesomeSolid" TextColor="#0D9488" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Glucose alert range" FontFamily="ManropeBold" FontSize="16" />
                                    <Label Text="Everyone is notified outside this range" FontSize="11" TextColor="#71817F" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,28,*" ColumnSpacing="8">
                                <Border BackgroundColor="#FFF5F5" Stroke="#FECACA" Padding="12,8" StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="0"><Label Text="LOWER LIMIT" FontSize="9" TextColor="#B91C1C" CharacterSpacing="1"/><Grid ColumnDefinitions="*,Auto"><Entry Text="{Binding LowThreshold}" Keyboard="Numeric" FontSize="22" FontFamily="ManropeBold" IsReadOnly="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}"/><Label Grid.Column="1" Text="mg/dL" FontSize="9" TextColor="#9A6A6A" VerticalOptions="End" Margin="0,0,0,9"/></Grid></VerticalStackLayout>
                                </Border>
                                <Label Grid.Column="1" Text="—" TextColor="#94A3B8" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="#FFF9EB" Stroke="#FDE68A" Padding="12,8" StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="0"><Label Text="UPPER LIMIT" FontSize="9" TextColor="#B45309" CharacterSpacing="1"/><Grid ColumnDefinitions="*,Auto"><Entry Text="{Binding HighThreshold}" Keyboard="Numeric" FontSize="22" FontFamily="ManropeBold" IsReadOnly="{Binding IsOwner, Converter={StaticResource InverseBoolConverter}}"/><Label Grid.Column="1" Text="mg/dL" FontSize="9" TextColor="#98784A" VerticalOptions="End" Margin="0,0,0,9"/></Grid></VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Button Text="Save alert range" IsVisible="{Binding IsOwner}" Command="{Binding SaveThresholdsCommand}" CornerRadius="12" HeightRequest="46" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="2,4,2,0">
                        <Label Text="Family members" FontFamily="ManropeBold" FontSize="17" />
                        <Border Grid.Column="1" BackgroundColor="#E8F7F5" StrokeThickness="0" Padding="10,4" StrokeShape="RoundRectangle 12"><Label Text="{Binding Members.Count, StringFormat='{0} members'}" FontSize="10" TextColor="#087268" /></Border>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="10">
                        <BindableLayout.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource MedicalCard}" StrokeShape="RoundRectangle 16" Padding="14">
                                <Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                    <Border Grid.RowSpan="2" WidthRequest="44" HeightRequest="44" BackgroundColor="#E8F7F5" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                                        <Label Text="&#xF007;" FontFamily="FontAwesomeSolid" FontSize="17" TextColor="#0D9488" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="7"><Label Text="{Binding FullName}" FontFamily="ManropeBold" FontSize="14"/><Border BackgroundColor="#E8F7F5" StrokeThickness="0" Padding="7,2" StrokeShape="RoundRectangle 9"><Label Text="{Binding Role}" FontSize="9" TextColor="#087268"/></Border></HorizontalStackLayout>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Email}" FontSize="11" TextColor="#71817F" LineBreakMode="TailTruncation" />
                                    <VerticalStackLayout Grid.Column="2" Grid.RowSpan="2" Spacing="4">
                                        <Button Text="{Binding AlertsText}" FontSize="10" HeightRequest="34" MinimumHeightRequest="34" Padding="9,3" CornerRadius="10" IsEnabled="{Binding CanToggleAlerts}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleAlertsCommand}" CommandParameter="{Binding .}" />
                                        <Button Text="Remove" FontSize="9" HeightRequest="30" MinimumHeightRequest="30" Padding="8,2" CornerRadius="9" IsVisible="{Binding CanRemove}" BackgroundColor="#FEF2F2" TextColor="#DC2626" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCommand}" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate></BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Leave family" Command="{Binding LeaveCommand}" Style="{StaticResource OutlineButton}" TextColor="#DC2626" BorderColor="#FECACA" CornerRadius="12" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasNoFamily}" Spacing="16">
                    <VerticalStackLayout Margin="4,16,4,8" Spacing="6">
                        <Label Text="Stay connected to the people who matter" FontFamily="ManropeBold" FontSize="25" HorizontalTextAlignment="Center" />
                        <Label Text="Create a private monitoring circle or join one with an invite code." FontSize="13" TextColor="#71817F" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border Style="{StaticResource MedicalCard}" StrokeShape="RoundRectangle 18" Padding="18">
                        <VerticalStackLayout Spacing="12"><Border WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" BackgroundColor="#E8F7F5" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label Text="&#xF2B5;" FontFamily="FontAwesomeSolid" TextColor="#0D9488" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Text="Join a family" FontFamily="ManropeBold" FontSize="18"/><Label Text="Enter the 8-character code shared by the family owner." FontSize="12" TextColor="#71817F"/><Border Style="{StaticResource InputContainerBorder}" Margin="0"><Entry Placeholder="e.g. F8K4P2QX" Text="{Binding JoinCode}" CharacterSpacing="2" MaxLength="12"/></Border><Button Text="Join family" Command="{Binding JoinCommand}" CornerRadius="12"/></VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10"><BoxView HeightRequest="1" BackgroundColor="#DDE5E4" VerticalOptions="Center"/><Label Grid.Column="1" Text="OR" FontSize="10" TextColor="#94A3B8"/><BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#DDE5E4" VerticalOptions="Center"/></Grid>
                    <Border Style="{StaticResource MedicalCard}" StrokeShape="RoundRectangle 18" Padding="18">
                        <VerticalStackLayout Spacing="12"><Border WidthRequest="44" HeightRequest="44" HorizontalOptions="Start" BackgroundColor="#EEF2FF" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label Text="&#xF0C0;" FontFamily="FontAwesomeSolid" TextColor="#4F46E5" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Text="Create your family" FontFamily="ManropeBold" FontSize="18"/><Label Text="You will become the owner and choose the alert range." FontSize="12" TextColor="#71817F"/><Border Style="{StaticResource InputContainerBorder}" Margin="0"><Entry Placeholder="Family name" Text="{Binding NewFamilyName}" MaxLength="150"/></Border><Button Text="Create family" Command="{Binding CreateCommand}" BackgroundColor="#4F46E5" CornerRadius="12"/></VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
