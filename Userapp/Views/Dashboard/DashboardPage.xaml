<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CGM.PatientApp.ViewModels.Dashboard"
             xmlns:models="clr-namespace:CGM.PatientApp.Models"
             xmlns:controls="clr-namespace:CGM.PatientApp.Controls"
             xmlns:dashboard="clr-namespace:CGM.PatientApp.Views.Dashboard"
             x:Class="CGM.PatientApp.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="GlucoTrack"
             BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#0F172A}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Global ScrollView for all tabs to ensure scrolling works across the complete app -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <Grid>
            <dashboard:HomeDashboardView
                BindingContext="{Binding}"
                IsVisible="{Binding IsHomeSelected}" />
            <dashboard:HistoryDashboardView
                BindingContext="{Binding}"
                IsVisible="{Binding IsHistorySelected}" />
            <dashboard:ReportsDashboardView
                BindingContext="{Binding}"
                IsVisible="{Binding IsReportsSelected}" />
            <dashboard:AlertsDashboardView
                BindingContext="{Binding}"
                IsVisible="{Binding IsAlertsSelected}" />
            <dashboard:ProfileDashboardView
                BindingContext="{Binding}"
                IsVisible="{Binding IsProfileSelected}" />
            </Grid>
        </ScrollView>

        <!-- ================= MODULAR DOCKED 5-ITEM BOTTOM NAVIGATION BAR ================= -->
        <controls:BottomNavBar Grid.Row="1" BindingContext="{Binding}" />

        <!-- Privacy & Security modal overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsPrivacySecurityOverlayVisible}"
              BackgroundColor="#99000000"
              Padding="20"
              ZIndex="100">
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{StaticResource BorderLightColor}"
                    Padding="20"
                    MaximumWidthRequest="520"
                    VerticalOptions="Center">
                <ScrollView MaximumHeightRequest="680">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Privacy &amp; Security" FontSize="21" FontAttributes="Bold" />
                                <Label Text="Change your password or manage your account."
                                       FontSize="12" TextColor="{StaticResource TextSecondaryLight}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="&#x2715;"
                                    Command="{Binding ClosePrivacySecurityCommand}"
                                    BackgroundColor="Transparent" TextColor="{StaticResource TextSecondaryLight}"
                                    FontSize="18" WidthRequest="44" HeightRequest="44" />
                        </Grid>

                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Stroke="{StaticResource BorderLightColor}" StrokeShape="RoundRectangle 14" Padding="14">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Change password" FontSize="16" FontAttributes="Bold" />

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Current password" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InputContainerBorder}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Entry Text="{Binding CurrentPassword}"
                                                   IsPassword="{Binding IsCurrentPasswordHidden}"
                                                   Placeholder="Enter current password" />
                                            <Label Grid.Column="1" Text="{Binding CurrentPasswordIcon}"
                                                   FontFamily="FontAwesomeSolid" FontSize="17"
                                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}"
                                                   Padding="12" VerticalOptions="Center"
                                                   SemanticProperties.Description="Show or hide current password">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleCurrentPasswordVisibilityCommand}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="New password" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InputContainerBorder}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Entry Text="{Binding NewPassword}"
                                                   IsPassword="{Binding IsNewPasswordHidden}"
                                                   Placeholder="At least 6 characters" />
                                            <Label Grid.Column="1" Text="{Binding NewPasswordIcon}"
                                                   FontFamily="FontAwesomeSolid" FontSize="17"
                                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}"
                                                   Padding="12" VerticalOptions="Center"
                                                   SemanticProperties.Description="Show or hide new password">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleNewPasswordVisibilityCommand}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Confirm new password" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource InputContainerBorder}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Entry Text="{Binding ConfirmNewPassword}"
                                                   IsPassword="{Binding IsConfirmNewPasswordHidden}"
                                                   Placeholder="Enter new password again" />
                                            <Label Grid.Column="1" Text="{Binding ConfirmNewPasswordIcon}"
                                                   FontFamily="FontAwesomeSolid" FontSize="17"
                                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}"
                                                   Padding="12" VerticalOptions="Center"
                                                   SemanticProperties.Description="Show or hide confirmed password">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleConfirmNewPasswordVisibilityCommand}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <Border IsVisible="{Binding HasSecurityError}"
                                        BackgroundColor="#FEE2E2" Stroke="#FCA5A5"
                                        StrokeShape="RoundRectangle 10" Padding="10">
                                    <Label Text="{Binding SecurityErrorMessage}" TextColor="#991B1B" FontSize="12" />
                                </Border>

                                <Button Text="Change Password"
                                        Command="{Binding ChangePasswordCommand}"
                                        IsEnabled="{Binding IsPasswordChangeBusy, Converter={StaticResource InverseBoolConverter}}"
                                        BackgroundColor="{StaticResource PrimaryLight}" TextColor="White"
                                        FontAttributes="Bold" HeightRequest="46" CornerRadius="12" />
                                <ActivityIndicator IsVisible="{Binding IsPasswordChangeBusy}"
                                                   IsRunning="{Binding IsPasswordChangeBusy}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="#FFF1F2" Stroke="#FECDD3"
                                StrokeShape="RoundRectangle 14" Padding="14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Delete account" FontSize="16" FontAttributes="Bold" TextColor="#BE123C" />
                                <Label Text="Permanently remove your account and all associated health data."
                                       FontSize="12" TextColor="#9F1239" />
                                <Button Text="Delete Account"
                                        Command="{Binding DeleteAccountCommand}"
                                        IsEnabled="{Binding IsPasswordChangeBusy, Converter={StaticResource InverseBoolConverter}}"
                                        BackgroundColor="#DC2626" TextColor="White"
                                        FontAttributes="Bold" HeightRequest="46" CornerRadius="12" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Custom Report Date Range Modal Overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsCustomReportDialogVisible}"
              BackgroundColor="#99000000"
              Padding="24"
              ZIndex="150">
            <Border StrokeShape="RoundRectangle 22"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeThickness="1"
                    Padding="22"
                    WidthRequest="330"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Select Date Range"
                                   FontFamily="ManropeBold"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}" />
                            <Label Text="Pick start and end dates for report"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="&#x2715;"
                                Command="{Binding CloseCustomReportDialogCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                FontSize="16" WidthRequest="36" HeightRequest="36" />
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="From (Start Date)" FontFamily="ManropeSemiBold" FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                Padding="12,4">
                            <DatePicker Date="{Binding CustomReportStartDate}"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
                                        BackgroundColor="Transparent"
                                        Format="MMM dd, yyyy" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="To (End Date)" FontFamily="ManropeSemiBold" FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                Padding="12,4">
                            <DatePicker Date="{Binding CustomReportEndDate}"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
                                        BackgroundColor="Transparent"
                                        Format="MMM dd, yyyy" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Command="{Binding CloseCustomReportDialogCommand}"
                                HeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}"
                                FontFamily="ManropeSemiBold"
                                FontSize="13" />
                        <Button Grid.Column="1"
                                Text="Apply"
                                Command="{Binding ApplyCustomReportFilterCommand}"
                                HeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="{StaticResource PrimaryLight}"
                                TextColor="#FFFFFF"
                                FontFamily="ManropeBold"
                                FontSize="13" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
