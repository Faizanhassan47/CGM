<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CGM.PatientApp.ViewModels.Dashboard"
             xmlns:models="clr-namespace:CGM.PatientApp.Models"
             xmlns:controls="clr-namespace:CGM.PatientApp.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CGM.PatientApp.Views.Dashboard.HistoryDashboardView"
             x:DataType="vm:DashboardViewModel">
<VerticalStackLayout IsVisible="{Binding IsHistorySelected}"
                                     Spacing="16"
                                     Padding="20,20,20,24">

                    <!-- Header & Export Icon -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Glucose History"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        
                        <!-- Download / Export Button -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 20"
                                WidthRequest="40"
                                HeightRequest="40"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource BorderLightColor}">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ExportReportCommand}" /></Border.GestureRecognizers>
                            <Label Text="&#xF019;" FontFamily="FontAwesomeSolid" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- MODERN TIMELINE DATE NAVIGATOR (REDESIGNED GLUCOSE HISTORY DATE SECTION) -->
                    <Border Style="{StaticResource MedicalCard}" Padding="10,14,10,18">
                        <VerticalStackLayout Spacing="14">
                            <!-- 1. Day Navigation Bar with Left/Right Arrows & Active Day Display -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center" Padding="4,0">
                                <!-- Previous Day Button -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                        Stroke="Transparent"
                                        IsEnabled="{Binding CanGoToPreviousDay}"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding CanGoToPreviousDay}" Value="False">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PreviousDayCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xF053;" FontFamily="FontAwesomeSolid" FontSize="13"
                                            TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                            HorizontalOptions="Center" VerticalOptions="Center" />
                                 </Border>

                                <!-- Active Selected Date Center Pill -->
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="&#xF073;" FontFamily="FontAwesomeRegular" FontSize="13"
                                                TextColor="{StaticResource PrimaryLight}" VerticalOptions="Center" />
                                        <Label Text="{Binding SelectedDateFormattedText}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                                VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="Daily Glycemic Timeline" FontSize="11" TextColor="{StaticResource TextSecondaryLight}" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Next Day Button -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                        Stroke="Transparent"
                                        IsEnabled="{Binding CanGoToNextDay}"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding CanGoToNextDay}" Value="False">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NextDayCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#xF054;" FontFamily="FontAwesomeSolid" FontSize="13"
                                            TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                            HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>

                            <!-- 2. Full 7-Day Glycemic Calendar Strip (All 7 Days Visible Simultaneously) -->
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" HeightRequest="80"
                                                   BindableLayout.ItemsSource="{Binding WeeklyCalendarDays}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarDayItem">
                                        <Border StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#583295:#F8FAFC'}"
                                                Stroke="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#583295:#E2E8F0'}"
                                                StrokeThickness="1.5"
                                                WidthRequest="39"
                                                HeightRequest="76"
                                                Padding="0,6"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=SelectCalendarDayCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayName}" FontSize="10" FontAttributes="Bold"
                                                       TextColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#CCFBF1:#64748B'}"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding DayNumber}" FontSize="16" FontAttributes="Bold"
                                                       TextColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF:#0F172A'}"
                                                       HorizontalTextAlignment="Center" />
                                                <!-- Sleek Glycemic Status Dot -->
                                                <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                                         Color="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF:#583295'}"
                                                         HorizontalOptions="Center" Margin="0,3,0,0" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Time Range Filter Pills (Today, 7D, 14D, 30D) -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <!-- Today -->
                        <Border Grid.Column="0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{Binding IsHistoryToday, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#FFFFFF'}"
                                Stroke="{Binding IsHistoryToday, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#E2E8F0'}"
                                Padding="12,8">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetHistoryFilterCommand}" CommandParameter="Today" /></Border.GestureRecognizers>
                            <Label Text="Today" FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding IsHistoryToday, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF:#64748B'}"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <!-- 7D -->
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{Binding IsHistory7D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#FFFFFF'}"
                                Stroke="{Binding IsHistory7D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#E2E8F0'}"
                                Padding="12,8">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetHistoryFilterCommand}" CommandParameter="7D" /></Border.GestureRecognizers>
                            <Label Text="7D" FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding IsHistory7D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF:#64748B'}"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <!-- 14D -->
                        <Border Grid.Column="2" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{Binding IsHistory14D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#FFFFFF'}"
                                Stroke="{Binding IsHistory14D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#E2E8F0'}"
                                Padding="12,8">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetHistoryFilterCommand}" CommandParameter="14D" /></Border.GestureRecognizers>
                            <Label Text="14D" FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding IsHistory14D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF:#64748B'}"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <!-- 30D -->
                        <Border Grid.Column="3" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{Binding IsHistory30D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#FFFFFF'}"
                                Stroke="{Binding IsHistory30D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#01B4F1:#E2E8F0'}"
                                Padding="12,8">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetHistoryFilterCommand}" CommandParameter="30D" /></Border.GestureRecognizers>
                            <Label Text="30D" FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding IsHistory30D, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF:#64748B'}"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Dynamic Glucose Readings List Card -->
                    <Border Style="{StaticResource MedicalCard}" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <!-- Table Header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <Label Grid.Column="0" Text="Glucose Readings" FontAttributes="Bold" FontSize="14" />
                                <Label Grid.Column="1" Text="{Binding GlucoseUnit}" FontSize="12" TextColor="{StaticResource TextMutedLight}" />
                            </Grid>

                            <!-- Dynamic Items -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding HistoryReadings}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryReadingItem">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                                <Label Grid.Column="0" Text="{Binding TimeText}" FontSize="12" TextColor="{StaticResource TextSecondaryLight}" VerticalOptions="Center" WidthRequest="110" />
                                                <Label Grid.Column="1" Text="{Binding ValueText}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                <Border Grid.Column="2" StrokeShape="RoundRectangle 8" BackgroundColor="{Binding StatusBgColor}" Padding="8,3" VerticalOptions="Center">
                                                    <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold" TextColor="{Binding StatusTextColor}" />
                                                </Border>
                                                <Label Grid.Column="3" Text="{Binding TrendArrow}" FontSize="16" FontAttributes="Bold" TextColor="{Binding TrendColor}" VerticalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" />
                                            </Grid>
                                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderLightColor}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- View All Footer Link -->
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,6,0,0">
                                <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenDetailCommand}" CommandParameter="All Readings" /></HorizontalStackLayout.GestureRecognizers>
                                <Label Text="View All Readings" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryLight}" />
                        <Label Text="&#xF054;" FontFamily="FontAwesomeSolid" FontSize="15" TextColor="{StaticResource PrimaryLight}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Daily Summary 2x2 Grid -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Daily Summary" FontAttributes="Bold" FontSize="15" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <!-- Average Glucose -->
                            <controls:MetricCard Grid.Row="0" Grid.Column="0"
                                                CardTitle="Average Glucose"
                                                CardValue="{Binding AvgGlucose}"
                                                CardSubValue="{Binding AvgDiffText}"
                                     IconText="&#xF201;"
                                                IconBgColor="{StaticResource BadgeGreenBg}"
                                                ValueColor="{StaticResource TextPrimaryLight}" />

                            <!-- Time in Range -->
                            <controls:MetricCard Grid.Row="0" Grid.Column="1"
                                                CardTitle="Time in Range"
                                                CardValue="{Binding TimeInRange}"
                                                CardSubValue="Goal: > 70%"
                                     IconText="&#xF140;"
                                                IconBgColor="{StaticResource BadgeGreenBg}"
                                                ValueColor="{StaticResource BadgeGreenText}" />

                            <!-- Highest -->
                            <controls:MetricCard Grid.Row="1" Grid.Column="0"
                                                CardTitle="Highest"
                                                CardValue="{Binding HighestGlucose}"
                                                CardSubValue="{Binding HighestTime}"
                                     IconText="&#xF062;"
                                                IconBgColor="{StaticResource BadgeRedBg}"
                                                ValueColor="{StaticResource Danger}" />

                            <!-- Lowest -->
                            <controls:MetricCard Grid.Row="1" Grid.Column="1"
                                                CardTitle="Lowest"
                                                CardValue="{Binding LowestGlucose}"
                                                CardSubValue="{Binding LowestTime}"
                                     IconText="&#xF063;"
                                                IconBgColor="{StaticResource BadgeBlueBg}"
                                                ValueColor="{StaticResource BadgeBlueText}" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
</ContentView>
