# ==============================================================================
# CGM Patient App - Environment Configuration (.env)
# ==============================================================================

# Backend API Base URL
CGM_API_BASE_URL=http://127.0.0.1:5232/

# Set to true to bypass backend and use in-memory mock data
CGM_USE_MOCK_SERVICES=false

# BLE Settings
CGM_USE_REAL_BLE=true

# Development Simulator Mode
CGM_ALLOW_BLE_SIMULATOR=false
