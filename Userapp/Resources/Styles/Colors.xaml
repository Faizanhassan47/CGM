<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- GlucoTrack Primary Teal Palette -->
    <Color x:Key="PrimaryLight">#0D9488</Color>
    <Color x:Key="PrimaryDark">#14B8A6</Color>
    <Color x:Key="PrimaryVariant">#047857</Color>
    <Color x:Key="PrimaryContainerLight">#E6F4EA</Color>
    <Color x:Key="PrimaryContainerDark">#134E4A</Color>

    <!-- Teal Hero Gradient Colors -->
    <Color x:Key="TealGradientStart">#0D9488</Color>
    <Color x:Key="TealGradientEnd">#047857</Color>

    <!-- Badge Colors -->
    <Color x:Key="BadgeGreenBg">#E6F4EA</Color>
    <Color x:Key="BadgeGreenText">#059669</Color>
    <Color x:Key="BadgeBlueBg">#EFF6FF</Color>
    <Color x:Key="BadgeBlueText">#2563EB</Color>
    <Color x:Key="BadgeAmberBg">#FEF3C7</Color>
    <Color x:Key="BadgeAmberText">#D97706</Color>
    <Color x:Key="BadgeRedBg">#FEE2E2</Color>
    <Color x:Key="BadgeRedText">#DC2626</Color>

    <!-- Semantic App Theme Colors -->
    <Color x:Key="PrimaryColor">#0D9488</Color>
    <Color x:Key="Primary">#0D9488</Color>
    <Color x:Key="Secondary">#0284C7</Color>

    <!-- Neutral & Backgrounds -->
    <Color x:Key="PageBgLight">#F8FAF9</Color>
    <Color x:Key="PageBgDark">#0F172A</Color>
    
    <Color x:Key="CardBgLight">#FFFFFF</Color>
    <Color x:Key="CardBgDark">#1E293B</Color>

    <Color x:Key="SurfaceVariantLight">#F1F5F3</Color>
    <Color x:Key="SurfaceVariantDark">#334155</Color>

    <Color x:Key="BorderLightColor">#E6F0EB</Color>
    <Color x:Key="BorderDarkColor">#334155</Color>

    <!-- Typography Colors -->
    <Color x:Key="TextPrimaryLight">#1E293B</Color>
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>

    <Color x:Key="TextSecondaryLight">#64748B</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <Color x:Key="TextMutedLight">#94A3B8</Color>
    <Color x:Key="TextMutedDark">#64748B</Color>

    <!-- Medical & Alert States -->
    <Color x:Key="GlucoseNormal">#10B981</Color>
    <Color x:Key="GlucoseLow">#EF4444</Color>
    <Color x:Key="GlucoseHigh">#F59E0B</Color>
    <Color x:Key="GlucoseUrgentLow">#B91C1C</Color>
    
    <Color x:Key="Success">#059669</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="Info">#0D9488</Color>

    <!-- Chart Target Band -->
    <Color x:Key="ChartTargetBandFill">#E6F4EA</Color>
    <Color x:Key="ChartTargetBandStroke">#86EFAC</Color>

    <!-- Standard Neutrals -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#0B0F19</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource Transparent}"/>

</ResourceDictionary>