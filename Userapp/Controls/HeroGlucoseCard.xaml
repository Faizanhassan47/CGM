<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CGM.PatientApp.Controls.HeroGlucoseCard"
             x:Name="thisHero">
    <Border StrokeShape="RoundRectangle 22"
            SemanticProperties.Description="Current glucose reading. Tap to open glucose history."
            Stroke="Transparent"
            Padding="20,18"
            Shadow="{AppThemeBinding Light={Shadow Brush={StaticResource PrimaryBrush}, Offset='0,6', Radius=16, Opacity=0.25}, Dark={Shadow Brush=Transparent}}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource TealGradientStart}" Offset="0.0" />
                <GradientStop Color="{StaticResource TealGradientEnd}" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding TapCommand, Source={x:Reference thisHero}}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="14">
            <!-- Top Row: Title & Trend Status Badge -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{Binding TitleText, Source={x:Reference thisHero}}"
                       FontSize="14"
                       TextColor="#E0F2FE" />
                
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#26FFFFFF"
                        Padding="10,3">
                    <Label Text="{Binding TrendText, Source={x:Reference thisHero}}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                </Border>
            </Grid>

            <!-- Big Metric Row: Glucose Value & Dynamic Trend Velocity Action Circle -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding GlucoseValue, Source={x:Reference thisHero}}"
                           FontSize="64"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center" />
                    <Label Text="{Binding GlucoseUnit, Source={x:Reference thisHero}}"
                           FontSize="15"
                           TextColor="#E0F2FE"
                           Margin="0,0,0,12"
                           VerticalOptions="End" />
                </HorizontalStackLayout>

                <!-- Dynamic Directional White Action Circle -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 24"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource White}"
                        Stroke="Transparent"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TapCommand, Source={x:Reference thisHero}}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding TrendArrow, Source={x:Reference thisHero}}"
                           SemanticProperties.Description="Glucose trend direction"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryLight}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Bottom Row: Last Updated & Hint -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{Binding LastUpdatedText, Source={x:Reference thisHero}}"
                       FontSize="12"
                       TextColor="#E0F2FE" />
                <Label Grid.Column="1"
                       Text="Tap for history →"
                       FontSize="11"
                       TextColor="#BAE6FD" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
