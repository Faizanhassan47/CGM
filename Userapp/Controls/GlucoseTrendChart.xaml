<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="CGM.PatientApp.Controls.GlucoseTrendChart">
    <Border Style="{StaticResource MedicalCard}" Padding="16,14">
        <VerticalStackLayout Spacing="12">
            <!-- Header & Filter Pills -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="1">
                    <Label Text="Glucose Trend &amp; Corridor"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#583295, Dark=#FFFFFF}" />
                    <Label Text="Continuous telemetry curve &amp; glycemic target band"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>

                <!-- Filter Pills (3H, 6H, 12H, 24H) -->
                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <!-- 3H -->
                    <Border StrokeShape="RoundRectangle 10" Padding="8,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTrend3H}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BadgeGreenBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTrendFilterCommand}" CommandParameter="3H" />
                        </Border.GestureRecognizers>
                        <Label Text="3H" FontSize="11">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTrend3H}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource BadgeGreenText}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Border>

                    <!-- 6H -->
                    <Border StrokeShape="RoundRectangle 10" Padding="8,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTrend6H}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BadgeGreenBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTrendFilterCommand}" CommandParameter="6H" />
                        </Border.GestureRecognizers>
                        <Label Text="6H" FontSize="11">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTrend6H}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource BadgeGreenText}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Border>

                    <!-- 12H -->
                    <Border StrokeShape="RoundRectangle 10" Padding="8,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTrend12H}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BadgeGreenBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTrendFilterCommand}" CommandParameter="12H" />
                        </Border.GestureRecognizers>
                        <Label Text="12H" FontSize="11">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTrend12H}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource BadgeGreenText}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Border>

                    <!-- 24H -->
                    <Border StrokeShape="RoundRectangle 10" Padding="8,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTrend24H}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BadgeGreenBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTrendFilterCommand}" CommandParameter="24H" />
                        </Border.GestureRecognizers>
                        <Label Text="24H" FontSize="11">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsTrend24H}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource BadgeGreenText}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Mini Summary Metrics Strip (Average, Range, TIR) -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,2">
                <!-- Average -->
                <Border StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#583295}"
                        Padding="6,4">
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                        <Label Text="AVG" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding TrendWindowAverage, FallbackValue='116 mg/dL'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource PrimaryLight}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Min -->
                <Border StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#583295}"
                        Padding="6,4">
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                        <Label Text="MIN" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding TrendWindowMin, FallbackValue='78'}" FontSize="11" FontAttributes="Bold" TextColor="#01B4F1" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Max -->
                <Border StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#583295}"
                        Padding="6,4">
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                        <Label Text="MAX" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding TrendWindowMax, FallbackValue='164'}" FontSize="11" FontAttributes="Bold" TextColor="#583295" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- TIR -->
                <Border StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#583295}"
                        Padding="6,4">
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                        <Label Text="IN TARGET" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding TrendWindowTir, FallbackValue='88%'}" FontSize="11" FontAttributes="Bold" TextColor="#583295" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Chart Canvas Area with Target Shaded Corridor (70-180 mg/dL) -->
            <Grid HeightRequest="200" Margin="0,2,0,0">
                <!-- Base Chart Container Background -->
                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#583295}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLightColor}, Dark={StaticResource BorderDarkColor}}"
                        StrokeThickness="1" />

                <!-- LiveCharts2 Cartesian Chart -->
                <lvc:CartesianChart
                    Series="{Binding TrendSeries}"
                    XAxes="{Binding TrendXAxes}"
                    YAxes="{Binding TrendYAxes}"
                    Sections="{Binding TrendSections}"
                    TooltipPosition="Hidden"
                    Margin="10" />

                <!-- Bottom Target Range Legend Strip -->
                <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center" Spacing="14" Margin="0,0,0,6">
                    <Label Text="● In target (70–180)" FontSize="9" TextColor="#01B4F1" FontAttributes="Bold" />
                    <Label Text="● Low (&lt;70)" FontSize="9" TextColor="#01B4F1" />
                    <Label Text="● High (&gt;180)" FontSize="9" TextColor="#583295" />
                    <Label Text="● Urgent (&lt;55 / &gt;250)" FontSize="9" TextColor="#583295" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
