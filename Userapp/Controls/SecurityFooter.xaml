<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CGM.PatientApp.Controls.SecurityFooter">
    <Border StrokeShape="RoundRectangle 16"
            BackgroundColor="{StaticResource PrimaryContainerLight}"
            Stroke="{StaticResource PrimaryContainerLight}"
            Padding="16,12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="38"
                    HeightRequest="38"
                    BackgroundColor="{StaticResource White}"
                    Stroke="Transparent"
                    VerticalOptions="Center">
        <Label Text="&#xF3ED;" FontFamily="FontAwesomeSolid"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Your health data is secure"
                       FontAttributes="Bold"
                       FontSize="13"
                       TextColor="{StaticResource BadgeGreenText}" />
                <Label Text="Readings support monitoring and do not replace emergency medical care."
                       FontSize="11"
                       TextColor="{StaticResource TextSecondaryLight}"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
