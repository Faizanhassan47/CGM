<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CGM.PatientApp.Controls.GlucoTrackLogo"
             x:Name="thisLogo">
    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
        <!-- Circular Droplet Orbit Icon -->
        <Border StrokeShape="RoundRectangle 36"
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource PrimaryLight}"
                StrokeThickness="3"
                Padding="8">
            <Label Text="&#xF043;" FontFamily="FontAwesomeSolid"
                   FontSize="30"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- Brand Name -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="0" Margin="0,4,0,0">
            <Label Text="Gluco"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
            <Label Text="Track"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryLight}" />
        </HorizontalStackLayout>
        
        <Label Text="Stay informed, stay in control."
               FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
