<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CGM.PatientApp.Controls.GlucoTrackLogo"
             x:Name="thisLogo">
    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
        <!-- Circular Droplet Orbit Icon -->
        <Image Source="logo.png"
               WidthRequest="72"
               HeightRequest="72"
               HorizontalOptions="Center" />

        <!-- Brand Name -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="0" Margin="0,4,0,0">
            <Label Text="Ai"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#583295, Dark=#FFFFFF}" />
            <Label Text="ma"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryLight}" />
        </HorizontalStackLayout>
        
        <Label Text="Stay informed, stay in control."
               FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
