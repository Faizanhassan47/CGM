<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.10" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Userapp\Enums\*.cs" Link="Enums\%(Filename)%(Extension)" />
    <Compile Include="..\Userapp\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\Userapp\Interfaces\*.cs" Link="Interfaces\%(Filename)%(Extension)" />
    <Compile Include="..\Userapp\Services\Cgm\CgmProtocolParser.cs" Link="Services\Cgm\CgmProtocolParser.cs" />
    <Compile Include="..\Userapp\Services\Cgm\CgmCommandBuilder.cs" Link="Services\Cgm\CgmCommandBuilder.cs" />
    <Compile Include="..\Userapp\Services\Cgm\GlucoseUnitConverter.cs" Link="Services\Cgm\GlucoseUnitConverter.cs" />
    <Compile Include="..\Userapp\Services\Ble\CgmDeviceFilter.cs" Link="Services\Ble\CgmDeviceFilter.cs" />
    <Compile Include="..\Userapp\Services\Sync\SyncRetryPolicy.cs" Link="Services\Sync\SyncRetryPolicy.cs" />
    <Compile Include="..\Userapp\Services\Database\*.cs" Link="Services\Database\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
